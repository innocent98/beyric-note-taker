# Vexa Lite settings. On the server: copy to .env.vexa in the project root (git-ignored),
# chmod 600, and fill in. deploy/README.md step 3 generates the secrets for you.
# ADMIN_TOKEN and ADMIN_API_TOKEN must be the same value (Vexa reads both names).
ADMIN_TOKEN=
ADMIN_API_TOKEN=
INTERNAL_API_SECRET=
NEXTAUTH_SECRET=
JWT_SECRET=
# Live transcription stays on: without it Vexa returns no speaker names.
TRANSCRIPTION_SERVICE_URL=https://api.openai.com
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=whisper-1
