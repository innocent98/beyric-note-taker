# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/notetaker

# compose.yaml overrides this for the containers (host.docker.internal:8056).
VEXA_BASE_URL=http://localhost:8056
VEXA_API_KEY=
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30

OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
NOTES_MODEL=gpt-5.4-mini

AUDIO_RETENTION_DAYS=7
OWNER_PASSWORD=
SESSION_SECRET=

# production refuses to start with an empty OWNER_PASSWORD or SESSION_SECRET.
# SESSION_SECRET: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Proxy addresses whose X-Forwarded-For is trusted (comma separated). Empty trusts none.
# With nginx on the host and compose.yaml's pinned network, nginx arrives as 172.28.0.1.
# compose.yaml uses that when this is left empty; set it only to change it.
TRUSTED_PROXY_IPS=172.28.0.1
