# Copy to .env and fill in. Never commit .env.
# Every secret below: generate with `openssl rand -hex 24` (SESSION_SECRET: `openssl rand -hex 48`).
# Production refuses to start with an empty SESSION_SECRET, and migration 0006 refuses to run
# without OWNER_EMAIL and OWNER_PASSWORD (it creates the admin account from them).

# ---- Databases ----
# The app's database password. compose.yaml builds the containers' DATABASE_URL from it.
POSTGRES_PASSWORD=
# Vexa's own database and storage, private to the Vexa containers.
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=

# ---- Vexa (the bot) ----
# From deploy/vexa-api-key.sh. Vexa's own settings, including its live transcription model
# (whisper-1, for speaker names only), are in .env.vexa, not here.
VEXA_API_KEY=
# Vexa Lite image tag compose runs. Change only after a test call on the new tag.
VEXA_IMAGE_TAG=v012
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30

# ---- OpenAI, used by this app after the meeting ----
OPENAI_API_KEY=
# Turns the recording into the transcript you read.
TRANSCRIPTION_MODEL=gpt-transcribe
# Adds speaker names to that transcript and writes the notes.
NOTES_MODEL=gpt-6-luna

# ---- App ----
AUDIO_RETENTION_DAYS=7
# The admin account, created by migration 0006 the first time it runs (the sign-in is then this
# email plus this password). After that, change the password in the app, not here: these two are
# not read again, so OWNER_PASSWORD can be removed from .env once the migration has run.
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Shared secret between nginx and the app: nginx sends it as X-Edge-Secret on every request and the
# app believes X-Forwarded-For (the visitor's address, which the login limits key on) only on a
# request that carries it. Generate with `openssl rand -hex 32`; the SAME value goes in nginx
# (deploy/README.md, "Edge secret"). Empty = not configured: the app logs a warning at startup
# and falls back to TRUSTED_PROXY_IPS, which any container on the server can forge.
EDGE_SHARED_SECRET=
# Transitional, only read while EDGE_SHARED_SECRET is empty: peer addresses whose X-Forwarded-For is
# believed (comma separated; the Next.js container, 172.28.1.10, is always on top of this list).
# Unset = 172.28.0.1, empty = none. Delete this line once the secret is live.
TRUSTED_PROXY_IPS=172.28.0.1

# ---- Only when running the app outside Docker on your own machine ----
# compose.yaml sets both of these for the containers, so leave them commented on a server.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/notetaker
# VEXA_BASE_URL=http://localhost:8056
