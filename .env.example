# ---- Core ----
APP_ENV=production
COOKIE_SECURE=true
SESSION_SECRET=
EDGE_SHARED_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD=
PUBLIC_BASE_URL=https://notes.beyrictech.com

# ---- Database ----
POSTGRES_PASSWORD=

# ---- Mail ----
RESEND_API_KEY=
MAIL_FROM="Beyric Note Taker <no-reply@notes.beyrictech.com>"

# ---- Google sign-in and calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=
CALENDAR_ENABLED=false

# ---- Microsoft ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SECRET_EXPIRES_ON=
MICROSOFT_CALENDAR_ENABLED=false

# ---- Bot provider (Skribby) ----
BOT_PROVIDER=skribby
SKRIBBY_API_KEY=
SKRIBBY_ACCOUNT_ID=
SKRIBBY_ACCOUNT_NAME=
SKRIBBY_BOT_NAME="Beyric Meeting Support"
BOT_INVITE_EMAIL=
BOT_CHAT_NOTICE_ENABLED=false

# ---- Transcription and notes ----
OPENAI_API_KEY=
TRANSCRIPT_SOURCE=own
SKRIBBY_TRANSCRIPTION_MODEL=groq/whisper-large-v3-turbo

# ---- Billing ----
BILLING_ENABLED=false
BILLING_ALLOWED_EMAILS=
TRIAL_SECONDS=0
HOURS_MODE=off
FEATURE_GATES_MODE=off
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_SECRET_HASH=
# FLUTTERWAVE_PUBLIC_KEY=

# ---- Feature switches ----
MULTI_TEAM_ENABLED=false
SERIES_FOLLOW_MEETINGS=false

# ---- Vexa (to remove once its cleanup is done) ----
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=
VEXA_API_KEY=
VEXA_IMAGE_TAG=v012
BOT_NAME="Beyric Note Taker (recording)"

