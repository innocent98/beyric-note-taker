# Copy to .env and fill in. Never commit .env.
# Every secret below: generate with `openssl rand -hex 24` (SESSION_SECRET: `openssl rand -hex 48`).
# The app refuses to start (outside APP_ENV=test) when SESSION_SECRET is shorter than 32 characters,
# and migration 0006 refuses to run
# without OWNER_EMAIL and OWNER_PASSWORD (it creates the admin account from them).

# ---- Databases ----
# The app's database password. compose.yaml builds the containers' DATABASE_URL from it.
POSTGRES_PASSWORD=
# Vexa's own database and storage, private to the Vexa containers.
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=

# ---- Vexa (the bot) ----
# From deploy/vexa-api-key.sh. Vexa's own settings, including its live transcription model
# (whisper-1, for speaker names only), are in .env.vexa, not here.
VEXA_API_KEY=
# Vexa Lite image tag compose runs. Change only after a test call on the new tag.
VEXA_IMAGE_TAG=v012
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30
# How long the bot may sit in a call with nobody else speaking before it leaves on its own, in
# seconds (sent to Vexa as automatic_leave.max_time_left_alone). It is a silence rule, not a
# headcount, so a short window can cut a quiet meeting (a long screen-share with no talking).
# Vexa's own default is 600 (10 minutes); 0 sends nothing and keeps Vexa's default. Change it here
# and recreate web and worker; it applies to bots sent after that.
BOT_LEFT_ALONE_SECONDS=300

# ---- OpenAI, used by this app after the meeting ----
OPENAI_API_KEY=
# Turns the recording into the transcript you read.
TRANSCRIPTION_MODEL=gpt-transcribe
# Adds speaker names to that transcript and writes the notes.
NOTES_MODEL=gpt-6-luna

# ---- App ----
AUDIO_RETENTION_DAYS=7
# The admin account, created by migration 0006 the first time it runs (the sign-in is then this
# email plus this password). After that, change the password in the app, not here: these two are
# not read again, so OWNER_PASSWORD can be removed from .env once the migration has run.
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Shared secret between nginx and the app: nginx sends it as X-Edge-Secret on every request and the
# app believes X-Forwarded-For (the visitor's address, which the login limits key on) only on a
# request that carries it. Generate with `openssl rand -hex 32`; the SAME value goes in nginx
# (deploy/README.md, "Edge secret"). Empty = not configured: the app logs a warning at startup and
# treats every client as the proxy's address, so all visitors share one login limit.
EDGE_SHARED_SECRET=

# ---- Pilot accounts: sign-up, email and Google sign-in ----
# The address the site is served on. Links in mail and the Google redirect address
# (PUBLIC_BASE_URL + /api/auth/google/callback, register it in the Google console) are built from it.
PUBLIC_BASE_URL=https://notes.beyrictech.com
# Mail: leave MAIL_PROVIDER empty to use Resend when RESEND_API_KEY is set. Without a key the app
# still runs, no verification or reset mail (and no token for one) is made, and password sign-up
# stays off (an admin can hand out reset links). "console" prints mail and is refused in production.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Beyric Note Taker <no-reply@notes.beyrictech.com>
# Optional. Notes mail (not sign-in mail) waits for the next day once this many mails have gone
# since 00:00 UTC (Resend's Free plan allows 100 a day; 0 = no cap), and one address gets at most
# MAIL_RECIPIENT_DAILY_CAP notes mails in 24 hours.
# MAIL_DAILY_CAP=80
# MAIL_RECIPIENT_DAILY_CAP=5
# Optional. A budget for ALL mail in a rolling hour (0 = none): over it mail waits (reason
# over_budget) and the admins are told once an hour. Password-reset and invitation mail may use
# all of it; verification mail and notes mail may not use the last MAIL_HOURLY_RESERVE (so a
# sign-up flood cannot keep a real person from a reset link); admin alerts are never held.
# MAIL_HOURLY_BUDGET=30   (0 means NO budget, unlimited: it does not stop mail)
# MAIL_HOURLY_RESERVE=10
# Admin alerts (no bot slot, a meeting that was not recorded) go to this address; empty = each
# admin's own address.
# ADMIN_ALERT_EMAIL=
# Sign in with Google (scopes openid, email, profile only). Both empty = the feature does not exist
# (the routes answer 404, GET /api/pilot says google_signin: false). From the Google Cloud console,
# OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connecting Google Calendar reuses this client (redirect address
# https://notes.beyrictech.com/api/calendar/google/callback must be registered on it too). The
# routes answer 404 until CALENDAR_ENABLED is true. GOOGLE_OAUTH_TESTING=true while the Google
# Cloud project is in Testing (a connection then records a 7-day expected expiry); false once it
# is in production. GOOGLE_APP_VERIFIED=true once Google has verified the app's sensitive scopes:
# until then the connect call tells the frontend to show the "Google hasn't verified this app" note.
GOOGLE_OAUTH_TESTING=false
GOOGLE_APP_VERIFIED=false
# Encrypts the secrets the app stores (the calendar refresh tokens, a pasted calendar link): 32
# random bytes, base64. Generate with `openssl rand -base64 32`. Required in production once
# GOOGLE_CLIENT_ID is set (the app refuses to start without it) and a set value must be valid.
# A server that has GOOGLE_CLIENT_ID set needs this BEFORE the deploy of the vault: without it web
# refuses to start (and deploy.sh rolls back). Append it without printing it:
#   printf 'TOKEN_ENC_KEY=%s\n' "$(openssl rand -base64 32)" >> .env
#   docker compose up -d --force-recreate web worker
# and copy the value into a password manager; losing it means every user reconnects.
# Keep it ONLY here: it is not in the database and not in a backup, so a stolen backup holds no
# usable token; losing it means every user reconnects their calendar. Rotation: put the new key in
# TOKEN_ENC_KEY, move the old one to TOKEN_ENC_KEY_PREVIOUS, raise TOKEN_ENC_KEY_VERSION by one,
# run the re-encrypt script, then remove the previous key.
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_PREVIOUS=
TOKEN_ENC_KEY_VERSION=1
# Set true where the calendar features are switched on; production then refuses to start without
# TOKEN_ENC_KEY (it already does once GOOGLE_CLIENT_ID is set).
CALENDAR_ENABLED=false
# Seconds before a calendar meeting starts that its bot is sent. Optional; 60 unless the join-time
# measurement (spike P0.8) says otherwise.
AUTOJOIN_LEAD_SECONDS=60
# Emergency stop for calendar auto-join, for operations only (it is ON by default and users have no
# switch for the feature as a whole). false: the scheduler sends no bot from any calendar and the
# app says so on Settings and Upcoming. Joins whose 15 minutes pass while it is off are closed
# SILENTLY when it comes back on (nobody is mailed "not recorded"); joins still inside their 15
# minutes then go out. Restart `scheduler` after changing it (the app reads the scheduler's record
# of it, so `web` need not be restarted for the notice).
# AUTOJOIN_ENABLED=true
# Hosts a pasted private calendar link may point at (comma separated; an exact name, or .suffix
# for every subdomain). Only you edit this, never a user. These defaults are unconfirmed against
# real feeds (spike C19): check them before relying on them.
ICS_ALLOWED_HOSTS=calendar.google.com,outlook.office365.com,outlook.live.com
# Bots allowed on meetings at once on the one local host, across all users, until the load test says
# more (section 9 of the pilot design). A new meeting past it answers 409 bot_busy. 0 sends no new
# bots. The old name MAX_ACTIVE_BOTS still works; this one wins when both are set.
BOT_MAX_LOCAL=1
# Bots one user may have on meetings at once (409 user_limit). It only matters once BOT_MAX_LOCAL is
# above it.
USER_BOT_LIMIT=2
# Teams links on calendar events are recognised either way; the bot joins them only when this is
# true, which waits for the Teams spike (P0.7). Until then a Teams event reads "Can't join yet".
TEAMS_JOIN_ENABLED=false

# Which bot provider puts the bot in meetings: `vexa` (the Vexa above, the default and the way
# back) or `skribby` (the hosted Skribby, docs/sop/2026-11-08-skribby-provider.md). An unknown value,
# or `skribby` with no SKRIBBY_API_KEY, stops web, worker and scheduler at startup. A meeting
# remembers the provider that ran it, so changing this never strands a meeting in flight; set
# `vexa` and restart to roll back.
BOT_PROVIDER=vexa

# ---- Skribby (read only when BOT_PROVIDER=skribby, or while a meeting Skribby ran is still open) ----
# The API key from the Skribby dashboard (Settings, API keys). Never logged or shown.
# SKRIBBY_API_KEY=
# The signed-in bot: the id of an Authenticated Account made in the Skribby dashboard (the Google
# account the bot joins as). Leave it out and the bot joins as a guest named SKRIBBY_BOT_NAME.
# SKRIBBY_ACCOUNT_ID=
# The name that signed-in Google account shows in a meeting; only used in the owner's
# "Admit '...'" line while the bot waits to be let in.
# SKRIBBY_ACCOUNT_NAME=
# The Google address of that signed-in account (a public address, not a secret). When it is set
# AND BOT_PROVIDER=skribby AND SKRIBBY_ACCOUNT_ID is set, the app shows a tip on Settings and on a
# waiting or not-admitted Google Meet meeting: "Add <address> to your event to skip the wait"
# (a signed-in bot on the guest list skips the waiting room). Empty = no tip. One plain address; a
# bad value stops the start-up naming this setting. Restart web, worker and scheduler after a change.
# BOT_INVITE_EMAIL=
# eu (default) or jp. The two regions keep their data apart.
# SKRIBBY_REGION=eu
# What a guest bot is called in the meeting. Names like "Bot", "Notetaker" or "Recording" raise
# Google's bot detection (Skribby's naming guide); a service-desk name does not.
# SKRIBBY_BOT_NAME=Beyric Meeting Support
# Skribby also transcribes; its text only tells us who spoke when (our own transcription still
# writes the transcript). On the Free plan only this model and `none` are allowed. `none` = no
# speaker names.
# SKRIBBY_TRANSCRIPTION_MODEL=groq/whisper-large-v3-turbo
# Extra hosts a recording may be fetched from, comma separated. Skribby's own domain and Amazon's
# storage are always allowed; any other host is refused until named here (the live check prints it).
# SKRIBBY_DOWNLOAD_HOSTS=

# ---- Only when running the app outside Docker on your own machine ----
# compose.yaml sets both of these for the containers, so leave them commented on a server.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/notetaker
# VEXA_BASE_URL=http://localhost:8056
