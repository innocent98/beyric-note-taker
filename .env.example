# Copy to .env and fill in. Never commit .env.
# Every secret below: generate with `openssl rand -hex 24` (SESSION_SECRET: `openssl rand -hex 48`).
# The app refuses to start (outside APP_ENV=test) when SESSION_SECRET is shorter than 32 characters,
# and migration 0006 refuses to run
# without OWNER_EMAIL and OWNER_PASSWORD (it creates the admin account from them).

# ---- Databases ----
# The app's database password. compose.yaml builds the containers' DATABASE_URL from it.
POSTGRES_PASSWORD=
# Vexa's own database and storage, private to the Vexa containers.
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=

# ---- Vexa (the bot) ----
# From deploy/vexa-api-key.sh. Vexa's own settings, including its live transcription model
# (whisper-1, for speaker names only), are in .env.vexa, not here.
VEXA_API_KEY=
# Vexa Lite image tag compose runs. Change only after a test call on the new tag.
VEXA_IMAGE_TAG=v012
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30
# How long the bot may sit in a call with nobody else speaking before it leaves on its own, in
# seconds (sent to Vexa as automatic_leave.max_time_left_alone). It is a silence rule, not a
# headcount, so a short window can cut a quiet meeting (a long screen-share with no talking).
# Vexa's own default is 600 (10 minutes); 0 sends nothing and keeps Vexa's default. Change it here
# and recreate web and worker; it applies to bots sent after that.
BOT_LEFT_ALONE_SECONDS=300

# ---- OpenAI, used by this app after the meeting ----
OPENAI_API_KEY=
# Turns the recording into the transcript you read.
TRANSCRIPTION_MODEL=gpt-transcribe
# Adds speaker names to that transcript and writes the notes.
NOTES_MODEL=gpt-6-luna

# ---- App ----
AUDIO_RETENTION_DAYS=7
# The admin account, created by migration 0006 the first time it runs (the sign-in is then this
# email plus this password). After that, change the password in the app, not here: these two are
# not read again, so OWNER_PASSWORD can be removed from .env once the migration has run.
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Shared secret between nginx and the app: nginx sends it as X-Edge-Secret on every request and the
# app believes X-Forwarded-For (the visitor's address, which the login limits key on) only on a
# request that carries it. Generate with `openssl rand -hex 32`; the SAME value goes in nginx
# (deploy/README.md, "Edge secret"). Empty = not configured: the app logs a warning at startup and
# treats every client as the proxy's address, so all visitors share one login limit.
EDGE_SHARED_SECRET=

# ---- Pilot accounts: sign-up, email and Google sign-in ----
# The address the site is served on. Links in mail and the Google redirect address
# (PUBLIC_BASE_URL + /api/auth/google/callback, register it in the Google console) are built from it.
PUBLIC_BASE_URL=https://notes.beyrictech.com
# Mail: leave MAIL_PROVIDER empty to use Resend when RESEND_API_KEY is set. Without a key the app
# still runs, no verification or reset mail (and no token for one) is made, and password sign-up
# stays off (an admin can hand out reset links). "console" prints mail and is refused in production.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Beyric Note Taker <no-reply@beyrictech.com>
# Sign in with Google (scopes openid, email, profile only). Both empty = the feature does not exist
# (the routes answer 404, GET /api/pilot says google_signin: false). From the Google Cloud console,
# OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the secrets the app stores (the calendar refresh tokens, a pasted calendar link): 32
# random bytes, base64. Generate with `openssl rand -base64 32`. Required in production once
# GOOGLE_CLIENT_ID is set (the app refuses to start without it) and a set value must be valid.
# Keep it ONLY here: it is not in the database and not in a backup, so a stolen backup holds no
# usable token; losing it means every user reconnects their calendar. Rotation: put the new key in
# TOKEN_ENC_KEY, move the old one to TOKEN_ENC_KEY_PREVIOUS, raise TOKEN_ENC_KEY_VERSION by one,
# run the re-encrypt script, then remove the previous key.
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_PREVIOUS=
TOKEN_ENC_KEY_VERSION=1
# Bots allowed on meetings at once across all users, until the load test says more (section 9 of the
# pilot design). A new meeting past it answers 409 bot_busy.
MAX_ACTIVE_BOTS=1

# ---- Only when running the app outside Docker on your own machine ----
# compose.yaml sets both of these for the containers, so leave them commented on a server.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/notetaker
# VEXA_BASE_URL=http://localhost:8056
