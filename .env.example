# Copy to .env and fill in. Never commit .env.
# Every secret below: generate with `openssl rand -hex 24` (SESSION_SECRET: `openssl rand -hex 48`).
# The app refuses to start (outside APP_ENV=test) when SESSION_SECRET is shorter than 32 characters,
# and migration 0006 refuses to run
# without OWNER_EMAIL and OWNER_PASSWORD (it creates the admin account from them).

# ---- Databases ----
# The app's database password. compose.yaml builds the containers' DATABASE_URL from it.
POSTGRES_PASSWORD=
# Vexa's own database and storage, private to the Vexa containers.
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=

# ---- Vexa (the bot) ----
# From deploy/vexa-api-key.sh. Vexa's own settings, including its live transcription model
# (whisper-1, for speaker names only), are in .env.vexa, not here.
VEXA_API_KEY=
# Vexa Lite image tag compose runs. Change only after a test call on the new tag.
VEXA_IMAGE_TAG=v012
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30
# How long the bot may sit in a call with nobody else speaking before it leaves on its own, in
# seconds (sent to Vexa as automatic_leave.max_time_left_alone). It is a silence rule, not a
# headcount, so a short window can cut a quiet meeting (a long screen-share with no talking).
# Vexa's own default is 600 (10 minutes); 0 sends nothing and keeps Vexa's default. Change it here
# and recreate web and worker; it applies to bots sent after that.
BOT_LEFT_ALONE_SECONDS=300

# ---- OpenAI, used by this app after the meeting ----
OPENAI_API_KEY=
# Turns the recording into the transcript you read.
TRANSCRIPTION_MODEL=gpt-transcribe
# Adds speaker names to that transcript and writes the notes.
NOTES_MODEL=gpt-6-luna

# ---- App ----
AUDIO_RETENTION_DAYS=7
# The admin account, created by migration 0006 the first time it runs (the sign-in is then this
# email plus this password). After that, change the password in the app, not here: these two are
# not read again, so OWNER_PASSWORD can be removed from .env once the migration has run.
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Shared secret between nginx and the app: nginx sends it as X-Edge-Secret on every request and the
# app believes X-Forwarded-For (the visitor's address, which the login limits key on) only on a
# request that carries it. Generate with `openssl rand -hex 32`; the SAME value goes in nginx
# (deploy/README.md, "Edge secret"). Empty = not configured: the app logs a warning at startup and
# treats every client as the proxy's address, so all visitors share one login limit.
EDGE_SHARED_SECRET=

# ---- Pilot accounts: sign-up, email and Google sign-in ----
# The address the site is served on. Links in mail and the Google redirect address
# (PUBLIC_BASE_URL + /api/auth/google/callback, register it in the Google console) are built from it.
PUBLIC_BASE_URL=https://notes.beyrictech.com
# Mail: leave MAIL_PROVIDER empty to use Resend when RESEND_API_KEY is set. Without a key the app
# still runs, no verification or reset mail (and no token for one) is made, and password sign-up
# stays off (an admin can hand out reset links). "console" prints mail and is refused in production.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Beyric Note Taker <no-reply@notes.beyrictech.com>
# Optional. Notes mail (not sign-in mail) waits for the next day once this many mails have gone
# since 00:00 UTC (Resend's Free plan allows 100 a day; 0 = no cap), and one address gets at most
# MAIL_RECIPIENT_DAILY_CAP notes mails in 24 hours.
# MAIL_DAILY_CAP=80
# MAIL_RECIPIENT_DAILY_CAP=5
# Optional. A budget for ALL mail in a rolling hour (0 = none): over it mail waits (reason
# over_budget) and the admins are told once an hour. Password-reset and invitation mail may use
# all of it; verification mail and notes mail may not use the last MAIL_HOURLY_RESERVE (so a
# sign-up flood cannot keep a real person from a reset link); admin alerts are never held.
# MAIL_HOURLY_BUDGET=30   (0 means NO budget, unlimited: it does not stop mail)
# MAIL_HOURLY_RESERVE=10
# Admin alerts (no bot slot, a meeting that was not recorded) go to this address; empty = each
# admin's own address.
# ADMIN_ALERT_EMAIL=
# Sign in with Google (scopes openid, email, profile only). Both empty = the feature does not exist
# (the routes answer 404, GET /api/pilot says google_signin: false). From the Google Cloud console,
# OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connecting Google Calendar reuses this client (redirect address
# https://notes.beyrictech.com/api/calendar/google/callback must be registered on it too). The
# routes answer 404 until CALENDAR_ENABLED is true. GOOGLE_OAUTH_TESTING=true while the Google
# Cloud project is in Testing (a connection then records a 7-day expected expiry); false once it
# is in production. GOOGLE_APP_VERIFIED=true once Google has verified the app's sensitive scopes:
# until then the connect call tells the frontend to show the "Google hasn't verified this app" note.
GOOGLE_OAUTH_TESTING=false
GOOGLE_APP_VERIFIED=false
# Encrypts the secrets the app stores (the calendar refresh tokens, a pasted calendar link): 32
# random bytes, base64. Generate with `openssl rand -base64 32`. Required in production once
# GOOGLE_CLIENT_ID is set (the app refuses to start without it) and a set value must be valid.
# A server that has GOOGLE_CLIENT_ID set needs this BEFORE the deploy of the vault: without it web
# refuses to start (and deploy.sh rolls back). Append it without printing it:
#   printf 'TOKEN_ENC_KEY=%s\n' "$(openssl rand -base64 32)" >> .env
#   docker compose up -d --force-recreate web worker
# and copy the value into a password manager; losing it means every user reconnects.
# Keep it ONLY here: it is not in the database and not in a backup, so a stolen backup holds no
# usable token; losing it means every user reconnects their calendar. Rotation: put the new key in
# TOKEN_ENC_KEY, move the old one to TOKEN_ENC_KEY_PREVIOUS, raise TOKEN_ENC_KEY_VERSION by one,
# run the re-encrypt script, then remove the previous key.
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_PREVIOUS=
TOKEN_ENC_KEY_VERSION=1
# Set true where the calendar features are switched on; production then refuses to start without
# TOKEN_ENC_KEY (it already does once GOOGLE_CLIENT_ID is set).
CALENDAR_ENABLED=false
# Seconds before a calendar meeting starts that its bot is sent. Optional; 60 unless the join-time
# measurement (spike P0.8) says otherwise.
AUTOJOIN_LEAD_SECONDS=60
# Emergency stop for calendar auto-join, for operations only (it is ON by default and users have no
# switch for the feature as a whole). false: the scheduler sends no bot from any calendar and the
# app says so on Settings and Upcoming. Joins whose 15 minutes pass while it is off are closed
# SILENTLY when it comes back on (nobody is mailed "not recorded"); joins still inside their 15
# minutes then go out. Restart `scheduler` after changing it (the app reads the scheduler's record
# of it, so `web` need not be restarted for the notice).
# AUTOJOIN_ENABLED=true

# Multi-team (docs/superpowers/specs/2026-11-13-multi-team-design.md). Leave it out (false) until
# the screens that understand several teams are live: while it is false a person is on one team at
# a time, as before. When true, accepting an invitation adds a team and keeps the personal one.
# Restart web, worker and scheduler after changing it.
# MULTI_TEAM_ENABLED=false
# Recurring meetings follow the meetings (docs/superpowers/specs/2026-11-14-series-follow-meetings.md):
# each team, and the person's personal space, has its own row of a recurring meeting holding only
# its own meetings. Leave it out (false) until `scripts/backfill_series_follow.py --apply` has run
# on the server; it does nothing unless MULTI_TEAM_ENABLED is true too. After changing it run
# `docker compose up -d --force-recreate web worker scheduler` (a plain restart does not re-read
# `.env`).
# SERIES_FOLLOW_MEETINGS=false
# Hosts a pasted private calendar link may point at (comma separated; an exact name, or .suffix
# for every subdomain). Only you edit this, never a user. These defaults are unconfirmed against
# real feeds (spike C19): check them before relying on them.
ICS_ALLOWED_HOSTS=calendar.google.com,outlook.office365.com,outlook.live.com
# Bots allowed on meetings at once across all users: a safety ceiling. Unset, it follows the bot
# provider: 1 under Vexa (the bots run on our own host, which fits about one), 20 under Skribby
# (the bots run on Skribby's servers; our plan there allows 25, with "Request an increase" on its
# billing page). A value here always wins; to use the default, leave the line out. A new meeting
# past it answers 409 bot_busy. 0 sends no new bots. The old name MAX_ACTIVE_BOTS still works; this
# one wins when both are set.
# BOT_MAX_LOCAL=20
# Bots one user may have on meetings at once (409 user_limit): the real per-person control under
# Skribby.
USER_BOT_LIMIT=2
# With HOURS_MODE=enforce, a second concurrent meeting of one person starts only if their hours cover
# this many minutes for each meeting running or just placed (the calendar event's length instead,
# when known). A first meeting is never held to it. 0 turns it off.
# HOURS_RESERVE_MINUTES=30
# Teams links on calendar events are recognised either way; the bot joins them only when this is
# true, which waits for the Teams spike (P0.7). Until then a Teams event reads "Can't join yet".
TEAMS_JOIN_ENABLED=false

# Which bot provider puts the bot in meetings: `vexa` (the Vexa above, the default and the way
# back) or `skribby` (the hosted Skribby, docs/sop/2026-11-08-skribby-provider.md). An unknown value,
# or `skribby` with no SKRIBBY_API_KEY, stops web, worker and scheduler at startup. A meeting
# remembers the provider that ran it, so changing this never strands a meeting in flight; set
# `vexa` and restart to roll back.
BOT_PROVIDER=vexa

# ---- Skribby (read only when BOT_PROVIDER=skribby, or while a meeting Skribby ran is still open) ----
# The API key from the Skribby dashboard (Settings, API keys). Never logged or shown.
# SKRIBBY_API_KEY=
# The signed-in bot: the id of an Authenticated Account made in the Skribby dashboard (the Google
# account the bot joins as). Leave it out and the bot joins as a guest named SKRIBBY_BOT_NAME.
# SKRIBBY_ACCOUNT_ID=
# The name that signed-in Google account shows in a meeting; only used in the owner's
# "Admit '...'" line while the bot waits to be let in.
# SKRIBBY_ACCOUNT_NAME=
# The Google address of that signed-in account (a public address, not a secret). When it is set
# AND BOT_PROVIDER=skribby AND SKRIBBY_ACCOUNT_ID is set, the app shows a tip on Settings and on a
# waiting or not-admitted Google Meet meeting: "Add <address> to your event to skip the wait"
# (a signed-in bot on the guest list skips the waiting room). Empty = no tip. One plain address; a
# bad value stops the start-up naming this setting. Restart web, worker and scheduler after a change.
# BOT_INVITE_EMAIL=
# The line the bot posts in the meeting chat when it joins: "Hi, I'm <bot name>. <owner> added me to
# record this meeting and write notes. If you'd rather not be recorded, please tell <owner> before we
# start." Skribby only (Vexa gets none). OFF by default: it has not run in a real meeting yet. Turn it
# on after one test meeting on each platform shows the line in the chat (docs/sop/2026-11-14-bot-chat-notice.md),
# off again by removing it. true or false. Restart web, worker and scheduler after a change.
# BOT_CHAT_NOTICE_ENABLED=false
# eu (default) or jp. The two regions keep their data apart.
# SKRIBBY_REGION=eu
# What a guest bot is called in the meeting. Names like "Bot", "Notetaker" or "Recording" raise
# Google's bot detection (Skribby's naming guide); a service-desk name does not.
# SKRIBBY_BOT_NAME=Beyric Meeting Support
# Each person can set their own note taker name in Settings; SKRIBBY_BOT_NAME is what they get when
# they leave it empty. A SIGNED-IN Google Meet bot always shows the Google account's own name
# (live evidence 2026-11-14), so set SKRIBBY_ACCOUNT_NAME to that name: Settings, the "Admit" line
# and the chat notice then say it. Keep this false unless a later live Meet call shows the custom
# name (docs/sop/2026-11-14-per-user-bot-name.md).
# BOT_NAME_APPLIES_WHEN_SIGNED_IN=false
# Skribby also transcribes; its text only tells us who spoke when (our own transcription still
# writes the transcript). On the Free plan only this model and `none` are allowed. `none` = no
# speaker names.
# SKRIBBY_TRANSCRIPTION_MODEL=groq/whisper-large-v3-turbo
# What the notes are made from: `own` (default; our OpenAI transcription) or `skribby` (Skribby's
# own transcript for Skribby meetings, falling back to ours when it is missing or too short; needs
# SKRIBBY_TRANSCRIPTION_MODEL=elevenlabs/scribe-v2, the only model allowed with `skribby`; startup
# refuses any other). Recreate web, worker and scheduler (`docker compose up -d --force-recreate`;
# a plain restart does not re-read `.env`).
# TRANSCRIPT_SOURCE=own
# The per-person hours rule (billing stages S1 and S2): `off` (default; only the old cap rule runs),
# `shadow` (the old rule still decides; each recording start also asks the new grants-based rule and
# logs one `hours_shadow` line when they disagree, and each counted recording is split across the
# person's grants), `enforce` (the grants-based rule decides, with the 80% and 100% notices and
# mail; do not switch it on before `docs/sop/2026-11-16-hours-enforce.md`, "Before switching on").
# Read the comparison with `docker compose exec -T web python scripts/hours_shadow_report.py
# </dev/null`. Recreate web, worker and scheduler to change it.
# HOURS_MODE=off
# The one-time trial (billing stage S10). `TRIAL_SECONDS` is the trial's size: 0 (default; leave unset)
# gives nobody one, 10800 (3 hours) is the recommended value. A person gets it once, when their email
# is first confirmed, in any `HOURS_MODE`, and it ends at the hours used or `TRIAL_DAYS` days (default
# 14) after it is given. The scheduler also gives one to every confirmed account that holds none (the
# accounts made after migration 0049) within a minute of the switch-on. `TRIAL_DAILY_BUDGET_SECONDS`
# caps the trial seconds given in any 24 hours (0 = no cap; it must not be smaller than
# `TRIAL_SECONDS`): people past it wait and get theirs when the window frees. Read
# `scripts/trial_report.py` first. Recreate web, worker and scheduler to change them. Exact order with
# a proof command per step: `docs/sop/2026-11-17-trial-and-pilot-expiry.md`.
# TRIAL_SECONDS=0
# TRIAL_DAYS=14
# TRIAL_DAILY_BUDGET_SECONDS=0
# The pilot hours' end (billing stage S10). Unset (default; leave unset): nothing expires. Set it to
# the day paid plans open (`2027-02-01`) and every pilot grant ends `PILOT_EXPIRY_DAYS` (60) days later,
# at the end of that day UTC, with one mail `PILOT_EXPIRY_NOTICE_DAYS` (14) days before, to confirmed
# people with hours left. Nobody's hours end sooner than `PILOT_EXPIRY_MIN_NOTICE_DAYS` (7) after their
# mail (if the job first acts later, that person's end moves out). The notice days must be at least the
# minimum, below the expiry days and at most 60. Acts only under HOURS_MODE=enforce. The mail text and
# the date need Adebayo's and the lawyer's confirmation: do NOT set it before. Recreate the scheduler.
# PAID_PLANS_OPEN_ON=
# PILOT_EXPIRY_DAYS=60
# PILOT_EXPIRY_NOTICE_DAYS=14
# PILOT_EXPIRY_MIN_NOTICE_DAYS=7
# The feature gates (billing stage S3): Ask Beyric, a NEW translation and rewriting notes with a
# template need a live plan or trial. `off` (default; leave unset): every feature stays open, as
# today. `shadow`: they stay open and one `feature_gates_shadow would have refused` line is logged
# (feature, user id, state; no names or emails) each time a person without a plan would have been
# refused; it changes nothing for anyone. `enforce`: 403 `plan_inactive`. Do NOT switch on `enforce`
# before go-live (S11): the pilot accounts use these features today. Recreate web, worker and
# scheduler to change it. See `docs/sop/2026-11-17-feature-gates-shadow.md`.
# FEATURE_GATES_MODE=off
# Payments (billing stage S4). `false` (default; leave unset): the webhook route
# `POST /api/billing/webhooks/{provider}` answers 404 and stores nothing. No payment provider is
# built for Flutterwave yet (S7); Paystack (S6) is built but needs its keys (below), so `true` accepts
# a webhook for a provider only once that provider's keys are set. Keys stay in the server `.env`.
# Recreate web, worker and scheduler to change it.
# BILLING_ENABLED=false
# Billing stage S5: the person's billing profile and billing country. With `BILLING_ENABLED=true`
# the routes `GET|PUT /api/billing/profile`, `PUT /api/billing/profile/country` and
# `GET /api/billing/route` answer for the allowed accounts (below); otherwise they are a 404 and
# write nothing.
# BILLING_COUNTRY_ROUTES: which currency and provider each billing country pays with, as
# `COUNTRY=CURRENCY:provider` or `COUNTRY=off` entries; `*` stands for every country with no entry
# of its own, and a country with an entry never falls through to `*`. Default (leave unset):
# `NG=NGN:paystack,*=USD:flutterwave`. To switch a provider off WRITE `off` for its countries:
# `NG=off,*=USD:flutterwave` refuses Nigeria (Paystack off), `NG=NGN:paystack,*=off` refuses
# everyone else (Flutterwave off). Merely deleting the `NG` entry does NOT switch Paystack off:
# Nigeria would then take the `*` route, dollars through Flutterwave. Only `paystack` (NGN) and
# `flutterwave` (USD) are accepted; a typo or a wrong pairing stops the process at start.
# BILLING_COUNTRY_ROUTES=NG=NGN:paystack,*=USD:flutterwave
# BILLING_ALLOWED_EMAILS: the accounts (comma-separated emails) that may use the billing routes
# while billing is on. CLOSED by default: empty means no account may, so turning billing on for a
# webhook test opens nothing to people. Put `*` in the list to open it to every account. Everyone
# else gets the same 404 as billing off.
# BILLING_ALLOWED_EMAILS=
# Billing stages S6 (Paystack, naira) and S7 (Flutterwave, dollars). KEYS GO ONLY IN THE SERVER'S `.env`: never in git, a chat, a
# log or a PR. All of these stay unset (empty) until the vendor's TEST keys exist; with no secret key set the
# adapter cannot make any call and refuses every webhook.
# BILLING_LIVE: `false` (default; leave unset) accepts TEST keys only (`sk_test_`, `pk_test_`;
# Flutterwave's contain `_TEST`): no real money can move. `true` accepts LIVE keys only (`sk_live_`,
# `pk_live_`; for Flutterwave any key that does not contain `_TEST`). A key of the other
# kind stops the process at start, naming the setting (the key is never printed). Switch to `true`
# only at go-live (S11). Recreate web, worker and scheduler to change it.
# BILLING_LIVE=false
# Billing stage S8: plans, packs and subscriptions. With `BILLING_ENABLED=true` the subscription
# routes (`/api/billing/plans`, `/subscription`, `/checkout`, `/payments/...`) answer for the
# allow-listed accounts and the SCHEDULER process runs the billing clock (renewals, retries on day
# 1 and day 2, the 3-day grace, the lapse, and the sweeper for payments whose webhook never
# came). Saved cards are encrypted with TOKEN_ENC_KEY, so that key must be set (it is already, for
# the calendar tokens). Needs migrations 0050, 0051 and 0052.
# BILLING_RETURN_URL: where the provider sends the payer back after the hosted checkout. Empty
# (default; leave unset) means PUBLIC_BASE_URL + `/billing/return`. That page only SHOWS the
# payment's state; nothing is granted there, so a wrong address costs nothing.
# BILLING_RETURN_URL=
# Billing stage S9: invoices and receipts. Each invoice copies these onto itself when it is issued
# (a later edit never changes an old one). **NOTHING here is a real number until Adebayo supplies
# it**: leave a value empty and that line is simply left off the invoice (nothing is invented).
# The values below are LABELLED PLACEHOLDERS to show the shape; do not put them on a live server.
# Test-mode invoices are marked "TEST INVOICE ... Not a tax document" whatever these say, and
# `scripts/billing_test_purchase.py preflight 1` notes each empty or placeholder line.
# BILLING_SELLER_NAME=Beyrichq LTD
# BILLING_SELLER_ADDRESS=PLACEHOLDER ADDRESS (not real), Lagos, Nigeria
# BILLING_SELLER_REGISTRATION_NO=RC-PLACEHOLDER-NOT-REAL
# BILLING_SELLER_TAX_ID=TIN-PLACEHOLDER-NOT-REAL
# BILLING_SELLER_EMAIL=
# BILLING_VAT_RATE_BP: the VAT INCLUDED in the price charged, in basis points (750 = 7.5%). Default 0:
# no VAT line. Whether Beyrichq charges VAT is the accountant's answer (spec section 6); a VAT ADDED
# on top of the price is not built. The rate is stored on each invoice when it is issued.
# BILLING_VAT_RATE_BP=0
# PAYSTACK_SECRET_KEY: the secret key (dashboard: the Developers overview page). Calls Paystack
# and, while PAYSTACK_WEBHOOK_SECRET is unset, checks the older `x-paystack-signature` header.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY: accepted and checked; nothing reads it yet (hosted checkout needs no public key).
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_WEBHOOK_SECRET: the webhook signing secret, `whsec_...` (dashboard: Developers > API
# configuration). Once set, every webhook must carry the timestamped `Paystack-Signature` header
# (300-second window) and the older header alone is refused. Test and live modes have their own.
# PAYSTACK_WEBHOOK_SECRET=
# Flutterwave (stage S7): all stay unset until Flutterwave TEST keys exist; with no secret key the
# adapter cannot make any call, and with no secret hash it refuses every webhook.
# FLUTTERWAVE_SECRET_KEY: the secret key (dashboard: Settings, API Keys). A test key contains `_TEST`.
# FLUTTERWAVE_SECRET_HASH: the "secret hash" you type into the dashboard's Webhooks page (choose the
# V3 webhook); Flutterwave sends it back unchanged in the `verif-hash` header of every webhook. Pick
# a long random value. Setting it without the secret key stops the process at start.
# FLUTTERWAVE_PUBLIC_KEY: accepted and checked; nothing reads it.
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_SECRET_HASH=
# FLUTTERWAVE_PUBLIC_KEY=
# Skribby sometimes leaves a speaker tag unnamed and lists `potential_speaker_names` instead. `true`
# (default; leave unset): such a tag may be named by elimination (the list minus the bot's names
# minus the names other tags have) or after a sole candidate (one name on every segment of the
# tag, nobody else has it), which can name a tag after someone who is not in the call.
# `false`: such a tag stays "Unknown speaker". Optional; recreate web, worker and scheduler.
# SKRIBBY_NAME_BY_ELIMINATION=true
# A speaker tag still unnamed after the rules above may take the name of the participant Meet's own
# "who is speaking" indicator (kept by Skribby) shows speaking most over it, only on a clear margin
# (at least 30 s, a fifth of the tag, and 3x the runner-up), after a clock check, and in a meeting where that indicator
# already agrees with the names Skribby gave. `true` (default; leave unset): on; costs one extra
# request to Skribby per finished meeting (kept in memory per process). `false`: such a tag stays
# "Unknown speaker". Independent of SKRIBBY_NAME_BY_ELIMINATION: with elimination off the timeline may
# still give a tag the name elimination would have given, when Meet agrees; turn both off to stop all
# derived names. A value that is not true or false stops web, worker and scheduler at startup.
# Recreate them to change it.
# NAME_BY_MEET_TIMELINE=true
# Line-level speaker correction (docs/sop/2026-11-19-line-level-speaker-correction.md): with
# TRANSCRIPT_SOURCE=skribby, a line moves to the person Meet's own speaking timeline shows speaking
# over it when exactly ONE person was lit (at least 1 s, no runner-up with a quarter of their
# seconds) and that person is not the one its tag says; after the same clock check the naming uses;
# only for a meeting whose speaker events were kept (Teams and Zoom change nothing). `true`
# (default; leave unset): on. `false` is the emergency switch, not a dial: every line keeps its tag's
# name. A value that is not true or false stops web, worker and scheduler at startup. Recreate them
# to change it.
# SPEAKER_LINE_CORRECTION=true
# With `skribby`: the share of meetings (0 to 100) where our transcription is ALSO run, only to
# compare numbers (read them with scripts/transcript_shadow_report.py). Costs OpenAI for that share.
# TRANSCRIPT_SHADOW_PERCENT=0
# Extra hosts a recording may be fetched from, comma separated. Skribby's own domain and Amazon's
# storage are always allowed; any other host is refused until named here (the live check prints it).
# SKRIBBY_DOWNLOAD_HOSTS=

# ---- Only when running the app outside Docker on your own machine ----
# compose.yaml sets both of these for the containers, so leave them commented on a server.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/notetaker
# VEXA_BASE_URL=http://localhost:8056
