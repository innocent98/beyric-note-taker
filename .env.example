# Copy to .env and fill in. Never commit .env.
# Every secret below: generate with `openssl rand -hex 24` (SESSION_SECRET: `openssl rand -hex 48`).
# Production refuses to start with an empty OWNER_PASSWORD or SESSION_SECRET.

# ---- Databases ----
# The app's database password. compose.yaml builds the containers' DATABASE_URL from it.
POSTGRES_PASSWORD=
# Vexa's own database and storage, private to the Vexa containers.
VEXA_DB_PASSWORD=
VEXA_STORAGE_SECRET=

# ---- Vexa (the bot) ----
# From deploy/vexa-api-key.sh. Vexa's own settings, including its live transcription model
# (whisper-1, for speaker names only), are in .env.vexa, not here.
VEXA_API_KEY=
# Vexa Lite image tag compose runs. Change only after a test call on the new tag.
VEXA_IMAGE_TAG=v012
BOT_NAME=Beyric Note Taker (recording)
POLL_INTERVAL_SECONDS=30

# ---- OpenAI, used by this app after the meeting ----
OPENAI_API_KEY=
# Turns the recording into the transcript you read.
TRANSCRIPTION_MODEL=gpt-transcribe
# Adds speaker names to that transcript and writes the notes.
NOTES_MODEL=gpt-6-luna

# ---- App ----
AUDIO_RETENTION_DAYS=7
OWNER_PASSWORD=
SESSION_SECRET=
APP_ENV=production
# Set to false only to try the app over plain http on your own machine.
COOKIE_SECURE=true
# Proxy addresses whose X-Forwarded-For is trusted (comma separated).
# With nginx on the host and compose.yaml's pinned network, nginx arrives as 172.28.0.1.
# If this line is removed, compose.yaml uses 172.28.0.1. If it is present but EMPTY, no proxy is
# trusted at all.
TRUSTED_PROXY_IPS=172.28.0.1

# ---- Only when running the app outside Docker on your own machine ----
# compose.yaml sets both of these for the containers, so leave them commented on a server.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/notetaker
# VEXA_BASE_URL=http://localhost:8056
