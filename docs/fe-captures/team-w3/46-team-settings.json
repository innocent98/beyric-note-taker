{
  "note": "`share_new_meetings` applies to the owner's and admins' meetings only, at first notes.",
  "client": "dan",
  "request": {
    "method": "PATCH",
    "path": "/api/team",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "Product team",
      "share_new_meetings": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "id": 2,
      "name": "Product team",
      "share_new_meetings": true,
      "my_role": "owner",
      "member_count": 3,
      "pending_invites": 0,
      "can_manage": true,
      "can_change_roles": true
    }
  }
}
