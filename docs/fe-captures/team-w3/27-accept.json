{
  "note": "Chidi's team of one dissolves into Dan's.",
  "client": "chidi",
  "request": {
    "method": "POST",
    "path": "/api/team/invites/accept",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "token": "<token>"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "id": 2,
      "name": "My team",
      "share_new_meetings": false,
      "my_role": "member",
      "member_count": 3,
      "pending_invites": 0,
      "can_manage": false,
      "can_change_roles": false
    }
  }
}
