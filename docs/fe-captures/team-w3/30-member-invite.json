{
  "note": "403 `team_forbidden`.",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/team/invites",
    "headers": {
      "X-CSRF-Token": "<csrf-H>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "invitees": [
        {
          "email": "x@example.test"
        }
      ],
      "role": "member"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "team_forbidden",
        "message": "Only an owner or admin of the team can do that."
      }
    }
  }
}
