{
  "note": "Admins cannot change roles: 403.",
  "client": "chidi",
  "request": {
    "method": "PATCH",
    "path": "/api/team/members/5",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "role": "admin"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "team_forbidden",
        "message": "Only the owner of the team can change roles."
      }
    }
  }
}
