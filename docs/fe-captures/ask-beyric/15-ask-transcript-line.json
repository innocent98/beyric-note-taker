{
  "note": "A transcript passage: `target` \"transcript\" and `line` is the 1-based row of the transcript string the meeting page draws.",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/ask",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "question": "What did Daniel say?"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "kind": "answer",
      "lead": "Here is what your meetings say.",
      "points": [
        {
          "text": "The answer drawn from the first passage.",
          "cites": [
            {
              "meeting_id": 1,
              "title": "Pricing review",
              "date_label": "Mon 2 Nov",
              "owner_name": null,
              "shared": false,
              "target": "transcript",
              "line": 1
            }
          ]
        }
      ]
    }
  }
}
