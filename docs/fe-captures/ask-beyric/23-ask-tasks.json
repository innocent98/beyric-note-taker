{
  "note": "Tasks path: no model, free even over the cap. The task from Dan's private meeting is listed with `cites: []` (Ada may see the task, not open the meeting).",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/ask",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "question": "What are my tasks?"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "kind": "tasks",
      "lead": "You have 2 open tasks assigned to you.",
      "points": [
        {
          "text": "Send the pricing sheet (due Fri 13 Nov, to do)",
          "cites": [
            {
              "meeting_id": 1,
              "title": "Pricing review",
              "date_label": "Mon 2 Nov",
              "owner_name": null,
              "shared": false,
              "target": "transcript",
              "line": 4
            }
          ]
        },
        {
          "text": "Prepare the reorganisation plan (to do)",
          "cites": []
        }
      ]
    }
  }
}
