{
  "note": "A deleted account looks unknown.",
  "client": "ben",
  "request": {
    "method": "POST",
    "path": "/api/session",
    "headers": {
      "X-CSRF-Token": "<csrf-G>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "email": "ben@example.test",
      "password": "<password>"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "invalid_credentials",
        "message": "That email or password is not right."
      }
    }
  }
}
