{
  "note": "",
  "client": "visitor",
  "request": {
    "method": "POST",
    "path": "/api/signup",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "Ada Example",
      "email": "ada@example.test",
      "password": "<password>",
      "accept_terms": true
    }
  },
  "response": {
