{
  "note": "The link stays usable.",
  "client": "visitor",
  "request": {
    "method": "POST",
    "path": "/api/verify-email",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "token": "<token-1>",
      "password": "<password>"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "password_mismatch",
        "message": "That is not the password you chose when you signed up. If you do not remember it, create the account again."
      }
    }
  }
}
