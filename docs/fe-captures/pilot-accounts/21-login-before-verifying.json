{
  "note": "A correct password for an unverified account: 403, no session.",
  "client": "visitor",
  "request": {
    "method": "POST",
    "path": "/api/session",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "email": "ada@example.test",
      "password": "<password>"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "email_not_verified",
        "message": "Confirm your email first: open the link we sent you."
      }
    }
  }
}
