{
  "note": "Her own running meeting: named as hers.",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/meetings",
    "headers": {
      "X-CSRF-Token": "<csrf-I>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "url": "https://meet.google.com/abc-defg-hik",
      "template_id": 5
    }
