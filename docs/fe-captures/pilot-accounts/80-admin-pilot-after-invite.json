{
  "note": "`slots_taken` counts the reservation.",
  "client": "admin",
  "request": {
    "method": "GET",
    "path": "/api/admin/pilot",
    "headers": {
      "Cookie": "session=<cookie>"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "signups_open": true,
      "max_accounts": 4,
      "default_hours_cap_seconds": 18000,
      "password_signup_enabled": true,
      "slots_taken": 4,
      "state": "full"
    }
  }
}
