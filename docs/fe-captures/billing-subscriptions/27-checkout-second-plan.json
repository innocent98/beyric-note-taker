{
  "note": "Already subscribed: 409 `already_subscribed`.",
  "client": "ada billing-on",
  "request": {
    "method": "POST",
    "path": "/api/billing/checkout",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "kind": "plan",
