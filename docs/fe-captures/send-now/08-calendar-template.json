{
  "note": "Choose it for calendar meetings (the runner and Send now read it).",
  "client": "signed-in user",
  "request": {
    "method": "PUT",
    "path": "/api/calendar/settings",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "calendar_template_id": 2
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "connected": false,
      "state": "not_connected",
      "state_text": "Google Calendar is not connected.",
      "account_email": null,
      "provider": null,
      "last_sync_at": null,
      "last_error": null,
      "rule": "all",
      "rule_text": "Joining all meetings",
      "calendar_template_id": 2,
      "auto_join_paused": false,
      "auto_join_paused_text": null,
      "upcoming": []
    }
  }
}
