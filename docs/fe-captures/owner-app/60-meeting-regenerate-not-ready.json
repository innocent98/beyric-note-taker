{
  "note": "",
  "request": {
    "method": "POST",
    "path": "/api/meetings/3/regenerate",
    "headers": {
      "X-CSRF-Token": "<csrf-C>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "template_id": 1
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "not_ready",
        "message": "Notes can only be rewritten once a meeting is ready."
      }
    }
  }
}
