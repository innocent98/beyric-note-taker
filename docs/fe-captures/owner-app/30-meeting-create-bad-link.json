{
  "note": "",
  "request": {
    "method": "POST",
    "path": "/api/meetings",
    "headers": {
      "X-CSRF-Token": "<csrf-C>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "url": "https://example.com/x",
      "template_id": 1
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "invalid_meeting_url",
        "message": "That is not a Google Meet or Zoom link. Paste the full meeting link."
      }
    }
  }
}
