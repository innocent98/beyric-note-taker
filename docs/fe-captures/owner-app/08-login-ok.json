{
  "note": "The csrf_token here replaces the one from before login.",
  "request": {
    "method": "POST",
    "path": "/api/session",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "email": "owner@example.test",
      "password": "capture-password-placeholder"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "set-cookie": "session=<cookie>; HttpOnly; Max-Age=7776000; Path=/; SameSite=lax"
    },
    "body": {
      "authenticated": true,
      "csrf_token": "<csrf-C>",
      "user": {
        "email": "owner@example.test",
        "name": null,
        "is_admin": true,
        "email_verified": true
      },
      "usage": {
        "used_seconds": 0,
        "cap_seconds": null
      }
    }
  }
}
