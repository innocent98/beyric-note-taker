{
  "note": "A write without the CSRF token.",
  "client": "signed-in user",
  "request": {
    "method": "PUT",
    "path": "/api/settings/name",
    "headers": {
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "name": "X"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "csrf_rejected",
        "message": "Missing or wrong X-CSRF-Token header. Read it from GET /api/session."
      }
    }
  }
}
