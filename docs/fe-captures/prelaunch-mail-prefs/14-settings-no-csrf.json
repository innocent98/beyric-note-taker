      "Cookie": "session=<cookie>"
    },
    "body": {
      "notify_email": false
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "code": "csrf_rejected",
