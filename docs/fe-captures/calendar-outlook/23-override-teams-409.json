{
  "note": "The per-meeting switch on a Teams event: 409 `not_joinable`.",
  "client": "signed-in user",
  "request": {
    "method": "PUT",
    "path": "/api/calendar/events/1/override",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "override": true
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "not_joinable",
        "message": "Microsoft Teams meetings cannot be joined yet"
      }
    }
  }
}
