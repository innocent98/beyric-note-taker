{
  "note": "`UK` is not a code (the United Kingdom is `GB`): 422 `billing_country_invalid`.",
  "client": "ada billing-on",
  "request": {
    "method": "PUT",
    "path": "/api/billing/profile/country",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "billing_country": "UK"
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "billing_country_invalid",
        "message": "That is not a country code we know. Pick one from the list."
      }
    }
  }
}
