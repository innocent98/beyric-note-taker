{
  "note": "A third inside 30 days: 409 `country_change_too_soon`. Nothing is written.",
  "client": "ada billing-on",
  "request": {
    "method": "PUT",
    "path": "/api/billing/profile/country",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "billing_country": "FR"
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
