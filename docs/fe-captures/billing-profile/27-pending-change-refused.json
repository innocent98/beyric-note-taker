{
  "note": "**NOT LIVE state, real refusal.** 409 `country_change_pending` while one waits.",
  "client": "ada billing-on",
  "request": {
    "method": "PUT",
    "path": "/api/billing/profile/country",
    "headers": {
      "X-CSRF-Token": "<csrf-D>",
      "Cookie": "device=<cookie>; session=<cookie>"
    },
    "body": {
      "billing_country": "US"
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "country_change_pending",
        "message": "A change of billing country is already waiting for the end of your paid period."
      }
    }
  }
}
