{
  "note": "Only making more is refused: 409 `team_limit` (Free).",
  "as": "Ada",
  "request": {
    "method": "POST",
    "path": "/api/teams",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "Another"
    }
  },
  "response": {
