{
  "note": "`from` after `to`: 422 `invalid_date_range`.",
  "request": {
    "method": "GET",
    "path": "/api/meetings?from=2026-11-09&to=2026-11-08",
    "headers": {
      "Cookie": "session=<cookie>"
    },
    "body": null
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "invalid_date_range",
        "message": "From must be on or before To. Swap the two dates."
      }
    }
  }
}
