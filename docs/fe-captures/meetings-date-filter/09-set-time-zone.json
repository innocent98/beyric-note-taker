{
  "note": "The owner picks Lagos (UTC+1) on Settings.",
  "request": {
    "method": "PUT",
    "path": "/api/settings/time-zone",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "time_zone": "Africa/Lagos"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "time_zone": "Africa/Lagos",
      "is_set": true
    }
  }
}
