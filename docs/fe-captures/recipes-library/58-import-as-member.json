{
  "note": "A member cannot save a brief, so cannot import for it: 403 `team_forbidden`.",
  "client": "cal",
  "request": {
    "method": "POST",
    "path": "/api/briefs/import",
    "headers": {
      "X-CSRF-Token": "<csrf-F>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "multipart": {
        "field": "file",
        "filename": "terms.txt",
        "bytes": 1,
        "content_type": "application/octet-stream"
      }
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "code": "team_forbidden",
        "message": "Only an owner or admin of the team can do that."
      }
    }
  }
}
