{
  "note": "A `key` that is not a starter: 404 `not_found`.",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/recipes",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "key": "nope",
      "name": "x"
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "code": "not_found",
        "message": "No such starter recipe."
      }
    }
  }
}
