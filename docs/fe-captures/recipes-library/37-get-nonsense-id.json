{
  "note": "An id too large to exist: 404, not an error.",
  "client": "ada",
  "request": {
    "method": "PUT",
    "path": "/api/recipes/99999999999",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "x"
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "code": "not_found",
        "message": "No such recipe."
      }
    }
  }
}
