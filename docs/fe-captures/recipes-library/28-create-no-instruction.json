{
  "note": "A name without an instruction (and no starter to copy): 422 `recipe_invalid`.",
  "client": "ada",
  "request": {
    "method": "POST",
    "path": "/api/recipes",
    "headers": {
      "X-CSRF-Token": "<csrf-B>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "No instruction"
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "error": {
        "code": "recipe_invalid",
        "message": "A recipe needs a name and an instruction."
      }
    }
  }
}
