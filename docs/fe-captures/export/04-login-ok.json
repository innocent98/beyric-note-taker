{
  "note": "The login every export needs. A GET export sends no CSRF token.",
  "request": {
    "method": "POST",
    "path": "/api/session",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "email": "owner@example.test",
      "password": "capture-password-placeholder"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "content-length": "240",
      "cache-control": "no-store",
      "x-content-type-options": "nosniff"
    },
    "body": {
      "authenticated": true,
      "csrf_token": "<csrf-B>",
      "user": {
        "email": "owner@example.test",
        "name": null,
        "is_admin": true,
        "email_verified": true
      },
      "usage": {
        "used_seconds": 0,
        "cap_seconds": null
      },
      "unread_notifications": 0
    }
  }
}
