{
  "note": "`accept_recording` left out of the body: the same plain 422, not `validation_error`.",
  "client": "visitor",
  "request": {
    "method": "POST",
    "path": "/api/signup",
    "headers": {
      "X-CSRF-Token": "<csrf-A>",
      "Cookie": "session=<cookie>"
    },
    "body": {
      "name": "Ada Example",
      "email": "ada@example.test",
      "password": "<password>",
      "accept_terms": true
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "recording_ack_required",
        "message": "Confirm that you will tell the people in your meetings that Beyric will record them."
      }
    }
  }
}
